{
  "name": "memeid-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/memeid/vite.config.ts",
    "start": "tsx server.ts",
    "lint": "tsc --build --dry",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "express": "^4.21.2",
    "tweetnacl": "^1.0.3",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.12",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
